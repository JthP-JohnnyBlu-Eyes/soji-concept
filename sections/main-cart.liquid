<div class="wrap" style="padding: 24px 16px 40px; max-width: 760px">
  <h1 style="font-size: 32px; margin-bottom: 12px">{{ 'cart.title' | t }}</h1>
  {%- if cart.item_count > 0 -%}
    <form action="{{ routes.cart_url }}" method="post">
      {%- for item in cart.items -%}
        <div class="cart-line">
          <a class="tile" href="{{ item.url }}">
            {%- if item.image -%}{{ item.image | image_url: width: 160 | image_tag: alt: item.title }}{%- else -%}{% render 'gem-placeholder', product: item.product %}{%- endif -%}
          </a>
          <div>
            <a href="{{ item.url }}" style="color: var(--ink); text-decoration: none">{{ item.product.title }}</a>
            {%- unless item.product.has_only_default_variant -%}<div class="meta">{{ item.variant.title }}</div>{%- endunless -%}
            <div class="meta">{{ item.final_price | money }}</div>
            <a href="{{ item.url_to_remove }}" class="meta">{{ 'cart.remove' | t }}</a>
          </div>
          <div>
            <label class="sr" for="qty-{{ forloop.index }}">{{ 'cart.quantity' | t }}</label>
            <input class="qty" id="qty-{{ forloop.index }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0">
          </div>
        </div>
      {%- endfor -%}
      <div style="display: flex; justify-content: space-between; padding: 18px 0; font-size: 18px">
        <span>{{ 'cart.subtotal' | t }}</span><strong>{{ cart.total_price | money }}</strong>
      </div>
      <p class="meta">{{ 'cart.shipping_note' | t }}</p>
      <div class="row">
        <button class="btn btn--dark" type="submit" name="update">{{ 'cart.update' | t }}</button>
        <button class="btn" type="submit" name="checkout" style="flex: 1">{{ 'cart.checkout' | t }}</button>
      </div>
    </form>
  {%- else -%}
    <p>{{ 'cart.empty' | t }}</p>
    <a class="btn" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue' | t }}</a>
  {%- endif -%}
</div>

{% schema %}
{ "name": "Winkelmand" }
{% endschema %}
