<section class="hero" style="min-height: 100vh; display: flex; align-items: center">
  <div class="hero__in" style="grid-template-columns: 1fr; text-align: center; justify-items: center; max-width: 640px">
    <img src="{{ 'soji-logo-ivory.png' | asset_url }}" alt="{{ shop.name }}" width="400" height="171" style="height: 64px; width: auto">
    <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    <h1 style="font-size: 40px">{{ section.settings.title }}</h1>
    <p>{{ section.settings.text }}</p>
    {%- form 'customer', style: 'display: flex; gap: 8px; width: 100%; flex-wrap: wrap' -%}
      <input type="hidden" name="contact[tags]" value="nieuwsbrief">
      {%- if form.posted_successfully? -%}
        <p class="notice" style="width: 100%">{{ 'newsletter.success' | t }}</p>
      {%- else -%}
        <label class="sr" for="pw-mail">{{ 'newsletter.email' | t }}</label>
        <input class="field" id="pw-mail" type="email" name="contact[email]" required autocomplete="email" placeholder="{{ 'newsletter.placeholder' | t }}" style="border-radius: 999px">
        <button class="btn btn--ivory" type="submit">{{ 'newsletter.button' | t }}</button>
      {%- endif -%}
    {%- endform -%}
    <details style="margin-top: 24px; color: #D5E2E0">
      <summary style="cursor: pointer">{{ 'password.enter' | t }}</summary>
      {%- form 'storefront_password', style: 'display: flex; gap: 8px; margin-top: 12px' -%}
        <label class="sr" for="pw">{{ 'password.label' | t }}</label>
        <input class="field" id="pw" type="password" name="password" autocomplete="current-password" style="border-radius: 999px">
        <button class="btn btn--ghost" type="submit">{{ 'password.button' | t }}</button>
        {%- if form.errors -%}<p class="notice">{{ form.errors | default_errors }}</p>{%- endif -%}
      {%- endform -%}
    </details>
  </div>
</section>

{% schema %}
{
  "name": "Wachtwoordpagina",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Bovenregel", "default": "Binnenkort" },
    { "type": "text", "id": "title", "label": "Titel", "default": "Zilver met een verhaal, voor jouw intentie" },
    { "type": "textarea", "id": "text", "label": "Tekst", "default": "Onze webshop opent binnenkort. Schrijf je in en hoor als eerste wanneer we live gaan." }
  ]
}
{% endschema %}
